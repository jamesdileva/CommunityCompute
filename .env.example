# CommunityCompute local overrides — copy to .env (never commit .env)
COORDINATOR_HOST=127.0.0.1
COORDINATOR_PORT=8000
COORDINATOR_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./communitycompute.db
HEARTBEAT_TIMEOUT_SECONDS=60
LEASE_DURATION_SECONDS=60
MODEL_CACHE_DIR=
WORKER_ID_FILE=.worker_id
LOG_LEVEL=info
# Second PC: set COORDINATOR_URL=http://<pc-a-lan-ip>:8000
