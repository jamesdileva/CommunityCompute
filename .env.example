# CommunityCompute local overrides — copy to .env (never commit .env)
COORDINATOR_HOST=127.0.0.1
COORDINATOR_PORT=8000
COORDINATOR_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./communitycompute.db
HEARTBEAT_TIMEOUT_SECONDS=60
LEASE_DURATION_SECONDS=60
MODEL_CACHE_DIR=
WORKER_ID_FILE=.worker_id
LOG_LEVEL=info
# Second PC: set COORDINATOR_URL=http://<pc-a-lan-ip>:8000
# Sprint 19 (internet prototype): https + wss when the coordinator serves TLS
# COORDINATOR_URL=https://<host>:8443
# Worker TLS trust: --ca-bundle <cert>.pem (proper CA or dev cert), or --insecure (DEV ONLY)
# Sprint 20: AUTH_ENABLED=true locks every worker-facing route behind bearer
# credentials (default false keeps the anonymous LAN dev flow working)
# AUTH_ENABLED=false
# Sprint 37: paid compute experiment (simulated money only; no payouts)
# BILLING_CURRENCY=USD
# PAYMENT_PROVIDER=simulated
# PRICING_NETWORK_FEE_PERCENT=20
# PRICING_RATE_CARD={"hello_compute": 5, "stats_range": 3, "embeddings": 10, "image_generate": 25}
# BILLING_MIN_TOPUP_CENTS=100
# BILLING_MAX_TOPUP_CENTS=100000
